table EMPLEADOS
	lineageTag: e7d8c461-7e28-4739-9339-29876f6e68ee

	measure 'Empleado Seleccionado' =
			
			IF(
			    HASONEVALUE(EMPLEADOS[Nombre_Empleado]),
			    SELECTEDVALUE(EMPLEADOS[Nombre_Empleado]),
			    "Todos"
			)
		lineageTag: 4e0f204d-7450-4f53-832d-e956fda8fc91

	measure 'Departamento Seleccionado' = ```
			
			IF(
			    HASONEVALUE(EMPLEADOS[Departamento]),
			    SELECTEDVALUE(EMPLEADOS[Departamento]),
			    "Todos"
			)
			
			
