	partition CALENDARIO = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("Z:\MIS TRABAJOS\RRHH dashboard\CSV\CALENDARIO.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Encabezados promovidos" = Table.PromoteHeaders(
				        Origen,
				        [PromoteAllScalars=true]
				    ),
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				        #"Encabezados promovidos",
				        {
				            {"Fecha", type date},
				            {"Año", Int64.Type},
				            {"Mes", Int64.Type},
				            {"NombreMes", type text},
				            {"Trimestre", Int64.Type},
				            {"Semana", Int64.Type},
				            {"DiaSemana", type text},
				            {"EsLaborable", type logical}
				        }
				    ),
				    #"NombreMes_ES" =
				        Table.AddColumn(
				            #"Tipo cambiado",
				            "NombreMes_ES",
				            each Date.MonthName([Fecha], "es-ES"),
				            type text
				        ),
				    #"DiaSemana_ES" =
				        Table.AddColumn(
				            #"NombreMes_ES",
				            "DiaSemana_ES",
				            each Date.DayOfWeekName([Fecha], "es-ES"),
				            type text
				        ),
				    #"Columnas quitadas" = Table.RemoveColumns(DiaSemana_ES,{"NombreMes", "DiaSemana"}),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Columnas quitadas",{"Fecha", "Año", "NombreMes_ES", "Mes", "Trimestre", "DiaSemana_ES", "Semana", "EsLaborable"})
				in
				    #"Columnas reordenadas"

