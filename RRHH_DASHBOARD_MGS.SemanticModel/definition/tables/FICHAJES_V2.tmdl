table FICHAJES_V2
	lineageTag: f8072ca2-e564-4a23-9ffe-0e447cbe9fa1

	measure 'SALDO HORARIO' = SUM(FICHAJES_V2[Horas_Trabajadas])-SUM(FICHAJES_V2[Horas_Teoricas])
		lineageTag: a981b684-d910-4e40-b015-10d153540c19

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% CUMPLIMIENTO' = DIVIDE(SUM(FICHAJES_V2[Horas_Trabajadas]),SUM(FICHAJES_V2[Horas_Teoricas]),0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 4e3cc203-4bf0-4eb9-9f4b-6562a5250805

	measure 'Estado Cumplimiento' =
			
			SWITCH(
			    TRUE(),
			    [% Cumplimiento] >= 1, "🟢",
			    [% Cumplimiento] >= 0.95, "🟠",
			    "🔴"
			)
		lineageTag: d92d480b-70fe-47fd-b6d4-63decfd7d3ee

